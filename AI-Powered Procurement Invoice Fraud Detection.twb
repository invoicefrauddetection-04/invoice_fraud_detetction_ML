    <worksheet name='Average Supplier Risk Score'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffffff' fontname='Segoe UI' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='training_invoices' name='federated.1q1txzt0lri11915ldsyq00jffgo' />
          </datasources>
          <datasource-dependencies datasource='federated.1q1txzt0lri11915ldsyq00jffgo'>
            <column caption='Average Supplier Risk Score' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0279306176286724]' role='measure' type='quantitative'>
