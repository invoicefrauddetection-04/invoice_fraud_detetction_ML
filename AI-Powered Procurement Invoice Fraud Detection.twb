      <column caption='Total Procurement Invoices' datatype='integer' name='[Calculation_0279306175176704]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([supplier_id])' />
      </column>
      <column caption='Fraudulent Invoices' datatype='integer' name='[Calculation_0279306175422465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_fraud])' />
      </column>
      <column caption='Fraud Rate %' datatype='real' default-format='p0.00%' name='[Calculation_0279306175578114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_fraud])/COUNT([supplier_id])' />
      </column>
      <column caption='Blacklisted Supplier Invoices' datatype='integer' name='[Calculation_0279306175913987]' role='measure' type='quantitative'>
