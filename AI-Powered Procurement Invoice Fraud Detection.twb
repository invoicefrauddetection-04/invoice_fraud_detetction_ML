      <column caption='Average Supplier Risk Score' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0279306176286724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([supplier_risk_score])' />
